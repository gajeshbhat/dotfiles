    "mattpocock-skills:domain-modeling": "name-only",
    "mattpocock-skills:codebase-design": "name-only",
    "mattpocock-skills:git-guardrails-claude-code": "name-only",
    "mattpocock-skills:grilling": "user-invocable-only",
    "mattpocock-skills:tdd": "user-invocable-only",
    "mattpocock-skills:diagnosing-bugs": "user-invocable-only",
    "mattpocock-skills:code-review": "user-invocable-only",
    "mattpocock-skills:prototype": "user-invocable-only",
    "mattpocock-skills:pr": "user-invocable-only",
    "mattpocock-skills:research": "user-invocable-only",
    "mattpocock-skills:wizard": "user-invocable-only",
    "mattpocock-skills:writing-for-agents": "user-invocable-only",
    "mattpocock-skills:setup-pre-commit": "off",
    "mattpocock-skills:migrate-to-shoehorn": "off",
    "mattpocock-skills:scaffold-exercises": "off",
    "agent-skills:source-driven-development": "name-only",
    "agent-skills:security-and-hardening": "name-only",
    "agent-skills:using-agent-skills": "user-invocable-only",
    "agent-skills:planning-and-task-breakdown": "user-invocable-only",
    "agent-skills:context-engineering": "user-invocable-only",
    "agent-skills:ci-cd-and-automation": "user-invocable-only",
    "agent-skills:constraint-driven-development": "user-invocable-only",
    "agent-skills:deprecation-and-migration": "user-invocable-only",
    "agent-skills:idea-refine": "user-invocable-only",
    "agent-skills:incremental-implementation": "user-invocable-only",
    "agent-skills:api-and-interface-design": "user-invocable-only",
    "agent-skills:test-driven-development": "user-invocable-only",
    "agent-skills:documentation-and-adrs": "user-invocable-only",
    "agent-skills:spec-driven-development": "user-invocable-only",
    "agent-skills:doubt-driven-development": "user-invocable-only",
    "agent-skills:git-workflow-and-versioning": "user-invocable-only",
    "agent-skills:shipping-and-launch": "user-invocable-only",
    "agent-skills:debugging-and-error-recovery": "user-invocable-only",
    "agent-skills:observability-and-instrumentation": "user-invocable-only",
    "agent-skills:code-simplification": "user-invocable-only",
    "agent-skills:code-review-and-quality": "user-invocable-only",
    "agent-skills:interview-me": "user-invocable-only",
    "agent-skills:performance-optimization": "user-invocable-only",
    "agent-skills:frontend-ui-engineering": "user-invocable-only",
    "agent-skills:browser-testing-with-devtools": "off",
    "pstack:setup-pstack": "off"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "workflowSizeGuideline": "small",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "caveman@caveman": true,
    "cc-plugin-you-should-know@builtin": true,
    "mattpocock-skills@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true,
    "pstack@cursor-plugins": true,
    "gauntlet@gauntlet": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    },
    "gauntlet": {
      "source": {
        "source": "github",
        "repo": "gajeshbhat/gauntlet"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "notify",
  "timeFormat": "12-hour",
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoContinueAtUsageLimit": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-generated.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gofmt.sh"
          }
        ]
      }
    ]
  }
}
