{
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:google-workspace": "off",
    "ponytail:ponytail": "user-invocable-only",
    "ponytail:ponytail-gain": "user-invocable-only",
    "ponytail:ponytail-help": "user-invocable-only",
    "ponytail:ponytail-debt": "user-invocable-only",
    "ponytail:ponytail-audit": "user-invocable-only",
    "caveman:caveman-setup": "off",
    "caveman:caveman-discover": "off",
    "caveman:caveman-evidence-review": "off",
    "caveman:caveman-manage": "off",
    "caveman:caveman-optimize": "off"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "workflowSizeGuideline": "small",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "gopls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "caveman@caveman": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "notify",
  "timeFormat": "12-hour",
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoContinueAtUsageLimit": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-generated.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gofmt.sh"
          }
        ]
      }
    ]
  }
}
