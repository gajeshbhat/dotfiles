#!/usr/bin/env bash
# settings.json hash: {{ include "dot_claude/settings.json" | sha256sum }}
# Adds the GitHub marketplaces in extraKnownMarketplaces, then installs every enabled plugin.
set -uo pipefail
command -v claude >/dev/null 2>&1 || { echo "[!] claude not installed; skipping plugin install"; exit 0; }
settings="$HOME/.claude/settings.json"

marketplaces="$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("\n".join(m["source"]["repo"] for m in d.get("extraKnownMarketplaces",{}).values() if m.get("source",{}).get("source")=="github"))' "$settings")"
for m in $marketplaces; do
  claude plugin marketplace add "$m" >/dev/null 2>&1 && echo "[+] marketplace $m" || echo "[=] marketplace $m (already added or unavailable)"
done

plugins="$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("\n".join(k for k,v in d.get("enabledPlugins",{}).items() if v))' "$settings")"
for p in $plugins; do
  claude plugin install "$p" >/dev/null 2>&1 && echo "[+] plugin $p" || echo "[!] could not install plugin $p"
done

# Language server for the gopls-lsp plugin, when the toolchain is present
if command -v go >/dev/null 2>&1 && ! command -v gopls >/dev/null 2>&1 && [ ! -x "$HOME/go/bin/gopls" ]; then
  go install golang.org/x/tools/gopls@latest && echo "[+] gopls"
fi

# CLIs behind the jevgrep skill and Spec Kit, pinned. `jg auth` (provider key) is manual.
if command -v npm >/dev/null 2>&1 && ! command -v jg >/dev/null 2>&1; then
  npm install -g --prefix "$HOME/.local" @dzhng/jevgrep@0.8.0 skillkit@1.24.0 >/dev/null 2>&1 && echo "[+] jevgrep, skillkit"
fi
if command -v uv >/dev/null 2>&1 && ! command -v specify >/dev/null 2>&1; then
  uv tool install specify-cli --from git+https://github.com/github/spec-kit.git@v1.1.1 >/dev/null 2>&1 && echo "[+] specify"
fi
